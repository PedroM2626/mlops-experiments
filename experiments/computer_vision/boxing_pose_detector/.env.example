# Configuration the experiment reads through python-dotenv (pose_classifier.py calls
# load_dotenv() and falls back to these defaults if unset).
# Copy to .env — .env itself is gitignored by this monorepo.

# MLflow experiment name. Default in code: "boxing-pose-classification"
MLFLOW_EXPERIMENT_NAME="boxing-pose-classification"

# Tracking backend. The original project used a local SQLite store; its
# contents are versioned under LFS at
# ../../artifacts/boxing_pose_detector_20260512_192700_419b421/model_artifacts/mlflow.db
# MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
