# Ensemble Pyramid — imagem batch (scikit-learn + Streamlit deps).
# O UI Streamlit referenciado anteriormente (flexible_ensemble_pyramid_ui_enhanced.py)
# nunca foi commitado; o artefato existente é o notebook abaixo. Por isso o
# default executa o notebook de ponta a ponta; para servir um UI, adicione o
# script streamlit e troque o CMD (exemplo comentado no final).
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_ensemble.txt .
RUN pip install --no-cache-dir -U pip && \
    pip install --no-cache-dir -r requirements_ensemble.txt

COPY . .

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser
ENV HOME=/home/appuser \
    PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1

# Execucao batch do ensemble existente (6 camadas, TF-IDF + meta-ensembles)
CMD ["jupyter", "nbconvert", "--to", "notebook", "--execute",
     "experiments/ensemble_pyramid.ipynb",
     "--output", "experiments/ensemble_pyramid.executed.ipynb",
     "--ExecutePreprocessor.timeout=3600"]

