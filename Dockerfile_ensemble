# Ensemble Pyramid — batch image (scikit-learn + Streamlit deps).
# The Streamlit UI previously referenced (flexible_ensemble_pyramid_ui_enhanced.py)
# was never committed; the existing artifact is the notebook below. So the
# default runs the notebook end to end; to serve a UI, add the
# streamlit script and change the CMD (commented example at the end).
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_ensemble.txt .
RUN pip install --no-cache-dir -U pip && \
    pip install --no-cache-dir -r requirements_ensemble.txt

COPY . .

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser
ENV HOME=/home/appuser \
    PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1

# Batch execution of the existing ensemble (6 layers, TF-IDF + meta-ensembles)
CMD ["jupyter", "nbconvert", "--to", "notebook", "--execute",
     "experiments/ensemble_pyramid.ipynb",
     "--output", "experiments/ensemble_pyramid.executed.ipynb",
     "--ExecutePreprocessor.timeout=3600"]

# Alternative (once a streamlit app is committed):
# EXPOSE 8501
# CMD ["streamlit", "run", "experiments/<your_app>.py", "--server.port=8501", "--server.address=0.0.0.0"]
